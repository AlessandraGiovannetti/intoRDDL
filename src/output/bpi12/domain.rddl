    cpfs {

        // ---- transizioni: catena di Bernoulli condizionati (stick-breaking) ----
        // quando un (stato,azione) ha piu' esiti osservati, ciascuno tranne
        // l'ultimo pesca con probabilita' condizionata al non essersi gia' verificato
        // uno degli esiti precedenti dello stesso gruppo (riferimento a s{T}')
        // Transizione diretta a singolo tick: niente variabili di staging.
        s0' = false;

        s1' = if (s0 ^ action-a-submitted) then true else false;

        s2' = if (s1 ^ action-a-partlysubmitted) then true else false;

        s3' = if ((s2 ^ action-a-preaccepted) | (s21 ^ action-a-preaccepted)) then (if (s2 ^ action-a-preaccepted) then (Bernoulli(0.998849)) else (if (s21 ^ action-a-preaccepted) then Bernoulli(0.000437) else false)) else (if (s41 ^ action-a-preaccepted) then (Bernoulli(0.001068)) else (if (s156 ^ action-a-preaccepted) then true else false));

        s4' = if ((s3 ^ action-a-accepted) | ((s9 ^ action-a-accepted) | (s22 ^ action-a-accepted))) then (if (s3 ^ action-a-accepted) then (Bernoulli(0.991667)) else (if (s9 ^ action-a-accepted) then (Bernoulli(0.995305)) else (if (s22 ^ action-a-accepted) then Bernoulli(0.001156) else false))) else (if ((s42 ^ action-a-accepted) | (s43 ^ action-a-accepted)) then (if (s42 ^ action-a-accepted) then (Bernoulli(0.006993)) else (if (s43 ^ action-a-accepted) then Bernoulli(0.003623) else false)) else (if (s68 ^ action-a-accepted) then (Bernoulli(0.004717)) else (if (s156 ^ action-a-accepted) then Bernoulli(0.992366) else false)));

        s5' = if (((s4 ^ action-o-selected) | (s6 ^ action-o-selected)) | ((s9 ^ action-o-selected) | (s10 ^ action-o-selected))) then (if ((s4 ^ action-o-selected) | (s6 ^ action-o-selected)) then (if (s4 ^ action-o-selected) then (Bernoulli(0.998141)) else (if (s6 ^ action-o-selected) then true else false)) else (if (s9 ^ action-o-selected) then (Bernoulli(0.988235)) else (if (s10 ^ action-o-selected) then Bernoulli(0.884615) else false))) else (if ((s43 ^ action-o-selected) | (s111 ^ action-o-selected)) then (if (s43 ^ action-o-selected) then (Bernoulli(0.013333)) else (if (s111 ^ action-o-selected) then Bernoulli(0.025000) else false)) else (if (s137 ^ action-o-selected) then (true) else (if (s153 ^ action-o-selected) then true else false)));

        s6' = if (s4 ^ action-a-finalized) then (true) else (if (s5 ^ action-a-finalized) then (true) else (if (s9 ^ action-a-finalized) then true else false));

        s7' = if (s5 ^ action-o-created) then (true) else (if (s6 ^ action-o-created) then (true) else (if (s153 ^ action-o-created) then true else false));

        s8' = if (s7 ^ action-o-sent) then true else false;

        s9' = if (((s3 ^ action-w-completeren-aanvraag) | ((s4 ^ action-w-completeren-aanvraag) | (s8 ^ action-w-completeren-aanvraag))) | ((s9 ^ action-w-completeren-aanvraag) | ((s42 ^ action-w-completeren-aanvraag) | (s43 ^ action-w-completeren-aanvraag)))) then (if ((s3 ^ action-w-completeren-aanvraag) | ((s4 ^ action-w-completeren-aanvraag) | (s8 ^ action-w-completeren-aanvraag))) then (if (s3 ^ action-w-completeren-aanvraag) then (Bernoulli(0.993266)) else (if (s4 ^ action-w-completeren-aanvraag) then (true) else (if (s8 ^ action-w-completeren-aanvraag) then true else false))) else (if (s9 ^ action-w-completeren-aanvraag) then (true) else (if (s42 ^ action-w-completeren-aanvraag) then (Bernoulli(0.002481)) else (if (s43 ^ action-w-completeren-aanvraag) then Bernoulli(0.001472) else false)))) else (if ((s67 ^ action-w-completeren-aanvraag) | ((s68 ^ action-w-completeren-aanvraag) | (s110 ^ action-w-completeren-aanvraag))) then (if (s67 ^ action-w-completeren-aanvraag) then (Bernoulli(0.006494)) else (if (s68 ^ action-w-completeren-aanvraag) then (Bernoulli(0.008174)) else (if (s110 ^ action-w-completeren-aanvraag) then Bernoulli(0.015625) else false))) else (if (s132 ^ action-w-completeren-aanvraag) then (Bernoulli(0.016484)) else (if (s156 ^ action-w-completeren-aanvraag) then (true) else (if (s181 ^ action-w-completeren-aanvraag) then true else false))));

        s10' = if (((s8 ^ action-w-nabellen-offertes) | ((s9 ^ action-w-nabellen-offertes) | (s10 ^ action-w-nabellen-offertes))) | ((s23 ^ action-w-nabellen-offertes) | ((s29 ^ action-w-nabellen-offertes) | (s43 ^ action-w-nabellen-offertes)))) then (if ((s8 ^ action-w-nabellen-offertes) | ((s9 ^ action-w-nabellen-offertes) | (s10 ^ action-w-nabellen-offertes))) then (if (s8 ^ action-w-nabellen-offertes) then (true) else (if (s9 ^ action-w-nabellen-offertes) then (Bernoulli(0.830592)) else (if (s10 ^ action-w-nabellen-offertes) then Bernoulli(0.623033) else false))) else (if (s23 ^ action-w-nabellen-offertes) then (Bernoulli(0.001278)) else (if (s29 ^ action-w-nabellen-offertes) then (Bernoulli(0.000345)) else (if (s43 ^ action-w-nabellen-offertes) then Bernoulli(0.059508) else false)))) else (if ((s50 ^ action-w-nabellen-offertes) | ((s68 ^ action-w-nabellen-offertes) | (s111 ^ action-w-nabellen-offertes))) then (if (s50 ^ action-w-nabellen-offertes) then (Bernoulli(0.053374)) else (if (s68 ^ action-w-nabellen-offertes) then (Bernoulli(0.067568)) else (if (s111 ^ action-w-nabellen-offertes) then Bernoulli(0.057992) else false))) else (if ((s135 ^ action-w-nabellen-offertes) | (s153 ^ action-w-nabellen-offertes)) then (if (s135 ^ action-w-nabellen-offertes) then (true) else (if (s153 ^ action-w-nabellen-offertes) then true else false)) else (if (s184 ^ action-w-nabellen-offertes) then (true) else (if (s191 ^ action-w-nabellen-offertes) then true else false))));

        s11' = if (((s9 ^ action-w-nabellen-offertes ^ ~s10') | ((s10 ^ action-w-nabellen-offertes ^ ~s10') | (s11 ^ action-w-nabellen-offertes))) | (((s12 ^ action-w-nabellen-offertes) | (s23 ^ action-w-nabellen-offertes ^ ~s10')) | ((s32 ^ action-w-nabellen-offertes) | (s50 ^ action-w-nabellen-offertes ^ ~s10')))) then (if ((s9 ^ action-w-nabellen-offertes ^ ~s10') | ((s10 ^ action-w-nabellen-offertes ^ ~s10') | (s11 ^ action-w-nabellen-offertes))) then (if (s9 ^ action-w-nabellen-offertes ^ ~s10') then (Bernoulli(0.873786)) else (if (s10 ^ action-w-nabellen-offertes ^ ~s10') then (Bernoulli(0.916509)) else (if (s11 ^ action-w-nabellen-offertes) then Bernoulli(0.856230) else false))) else (if ((s12 ^ action-w-nabellen-offertes) | (s23 ^ action-w-nabellen-offertes ^ ~s10')) then (if (s12 ^ action-w-nabellen-offertes) then (true) else (if (s23 ^ action-w-nabellen-offertes ^ ~s10') then Bernoulli(0.000640) else false)) else (if (s32 ^ action-w-nabellen-offertes) then (Bernoulli(0.006122)) else (if (s50 ^ action-w-nabellen-offertes ^ ~s10') then Bernoulli(0.002592) else false)))) else (if ((s68 ^ action-w-nabellen-offertes ^ ~s10') | ((s111 ^ action-w-nabellen-offertes ^ ~s10') | (s133 ^ action-w-nabellen-offertes))) then (if (s68 ^ action-w-nabellen-offertes ^ ~s10') then (Bernoulli(0.010870)) else (if (s111 ^ action-w-nabellen-offertes ^ ~s10') then (Bernoulli(0.022523)) else (if (s133 ^ action-w-nabellen-offertes) then true else false))) else (if ((s134 ^ action-w-nabellen-offertes) | (s159 ^ action-w-nabellen-offertes)) then (if (s134 ^ action-w-nabellen-offertes) then (true) else (if (s159 ^ action-w-nabellen-offertes) then true else false)) else (if (s160 ^ action-w-nabellen-offertes) then (true) else (if (s161 ^ action-w-nabellen-offertes) then true else false))));

