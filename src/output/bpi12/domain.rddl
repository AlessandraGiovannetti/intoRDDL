        // -----------------------
        // attributi dello stato, TUTTI booleani nativi (fluents di prima classe,
        // usabili nella reward, nessun 'real'): gli attributi 'tri' (True/False/
        // missing, missing->false) sono un singolo booleano; TUTTE le colonne
        // categoriche - incluse quelle numeriche non discretizzate a monte, se
        // con pochi valori distinti - sono one-hot: un booleano PER CIASCUN
        // VALORE possibile, esattamente uno vero
        // -----------------------
        amount-req-high : { state-fluent, bool, default=false };
        amount-req-low : { state-fluent, bool, default=false };
        amount-req-medium : { state-fluent, bool, default=false };
        execution-time-minutes-high : { state-fluent, bool, default=false };
        execution-time-minutes-low : { state-fluent, bool, default=false };
        execution-time-minutes-medium : { state-fluent, bool, default=false };

        // -----------------------
        // azioni: una booleana scalare per ciascuna attivita' osservata nel log
        // -----------------------
        action-a-accepted : { action-fluent, bool, default=false };
        action-a-activated : { action-fluent, bool, default=false };
        action-a-approved : { action-fluent, bool, default=false };
        action-a-cancelled : { action-fluent, bool, default=false };
        action-a-declined : { action-fluent, bool, default=false };
        action-a-finalized : { action-fluent, bool, default=false };
        action-a-partlysubmitted : { action-fluent, bool, default=false };
        action-a-preaccepted : { action-fluent, bool, default=false };
        action-a-registered : { action-fluent, bool, default=false };
        action-a-submitted : { action-fluent, bool, default=false };
        action-o-accepted : { action-fluent, bool, default=false };
        action-o-cancelled : { action-fluent, bool, default=false };
        action-o-created : { action-fluent, bool, default=false };
        action-o-declined : { action-fluent, bool, default=false };
        action-o-selected : { action-fluent, bool, default=false };
        action-o-sent : { action-fluent, bool, default=false };
        action-o-sent-back : { action-fluent, bool, default=false };
        action-w-afhandelen-leads : { action-fluent, bool, default=false };
        action-w-beoordelen-fraude : { action-fluent, bool, default=false };
        action-w-completeren-aanvraag : { action-fluent, bool, default=false };
        action-w-nabellen-incomplete-dossiers : { action-fluent, bool, default=false };
        action-w-nabellen-offertes : { action-fluent, bool, default=false };
        action-w-valideren-aanvraag : { action-fluent, bool, default=false };
        action-archive-application : { action-fluent, bool, default=false };
    };

    cpfs {

        // ---- transizioni: catena di Bernoulli condizionati (stick-breaking) ----
        // quando un (stato,azione) ha piu' esiti osservati, ciascuno tranne
        // l'ultimo pesca con probabilita' condizionata al non essersi gia' verificato
        // uno degli esiti precedenti dello stesso gruppo (riferimento a s{T}')
        // Transizione diretta a singolo tick: niente variabili di staging.
        s0' = false;

        s1' = if (s0 ^ action-a-submitted) then true else false;

        s2' = if (s1 ^ action-a-partlysubmitted) then true else false;

        s3' = if (s2 ^ action-a-preaccepted) then Bernoulli(0.769231) else false;

        s4' = if ((s3 ^ action-a-accepted) | ((s9 ^ action-a-accepted) | (s37 ^ action-a-accepted))) then (if (s3 ^ action-a-accepted) then (Bernoulli(0.336597)) else (if (s9 ^ action-a-accepted) then (Bernoulli(0.994065)) else (if (s37 ^ action-a-accepted) then Bernoulli(0.002571) else false))) else (if ((s80 ^ action-a-accepted) | (s148 ^ action-a-accepted)) then (if (s80 ^ action-a-accepted) then (Bernoulli(0.005848)) else (if (s148 ^ action-a-accepted) then Bernoulli(0.015625) else false)) else (if (s196 ^ action-a-accepted) then (true) else (if (s197 ^ action-a-accepted) then Bernoulli(0.015625) else false)));

        s5' = if (((s4 ^ action-o-selected) | (s6 ^ action-o-selected)) | ((s9 ^ action-o-selected) | (s10 ^ action-o-selected))) then (if ((s4 ^ action-o-selected) | (s6 ^ action-o-selected)) then (if (s4 ^ action-o-selected) then (true) else (if (s6 ^ action-o-selected) then true else false)) else (if (s9 ^ action-o-selected) then (true) else (if (s10 ^ action-o-selected) then true else false))) else (if ((s16 ^ action-o-selected) | (s37 ^ action-o-selected)) then (if (s16 ^ action-o-selected) then (true) else (if (s37 ^ action-o-selected) then Bernoulli(0.022727) else false)) else (if (s44 ^ action-o-selected) then (Bernoulli(0.033898)) else (if (s72 ^ action-o-selected) then (true) else (if (s73 ^ action-o-selected) then true else false))));

        s6' = if (s4 ^ action-a-finalized) then (true) else (if (s5 ^ action-a-finalized) then (true) else (if (s9 ^ action-a-finalized) then true else false));

        s7' = if (s5 ^ action-o-created) then (true) else (if (s6 ^ action-o-created) then (true) else (if (s73 ^ action-o-created) then true else false));

        s8' = if (s7 ^ action-o-sent) then true else false;

        s9' = if (((s3 ^ action-w-completeren-aanvraag) | (s4 ^ action-w-completeren-aanvraag)) | ((s8 ^ action-w-completeren-aanvraag) | (s9 ^ action-w-completeren-aanvraag))) then (if ((s3 ^ action-w-completeren-aanvraag) | (s4 ^ action-w-completeren-aanvraag)) then (if (s3 ^ action-w-completeren-aanvraag) then (Bernoulli(0.320828)) else (if (s4 ^ action-w-completeren-aanvraag) then true else false)) else (if (s8 ^ action-w-completeren-aanvraag) then (Bernoulli(0.995757)) else (if (s9 ^ action-w-completeren-aanvraag) then Bernoulli(0.990783) else false))) else (if ((s37 ^ action-w-completeren-aanvraag) | (s80 ^ action-w-completeren-aanvraag)) then (if (s37 ^ action-w-completeren-aanvraag) then (Bernoulli(0.004167)) else (if (s80 ^ action-w-completeren-aanvraag) then Bernoulli(0.007634) else false)) else (if (s85 ^ action-w-completeren-aanvraag) then (Bernoulli(0.002404)) else (if (s148 ^ action-w-completeren-aanvraag) then (Bernoulli(0.016260)) else (if (s196 ^ action-w-completeren-aanvraag) then Bernoulli(0.988636) else false))));

        s10' = if (((s8 ^ action-w-nabellen-offertes) | ((s9 ^ action-w-nabellen-offertes) | (s10 ^ action-w-nabellen-offertes))) | ((s11 ^ action-w-nabellen-offertes) | ((s24 ^ action-w-nabellen-offertes) | (s37 ^ action-w-nabellen-offertes)))) then (if ((s8 ^ action-w-nabellen-offertes) | ((s9 ^ action-w-nabellen-offertes) | (s10 ^ action-w-nabellen-offertes))) then (if (s8 ^ action-w-nabellen-offertes) then (Bernoulli(0.979167)) else (if (s9 ^ action-w-nabellen-offertes) then (true) else (if (s10 ^ action-w-nabellen-offertes) then Bernoulli(0.991150) else false))) else (if (s11 ^ action-w-nabellen-offertes) then (true) else (if (s24 ^ action-w-nabellen-offertes) then (Bernoulli(0.000668)) else (if (s37 ^ action-w-nabellen-offertes) then Bernoulli(0.001815) else false)))) else (if ((s44 ^ action-w-nabellen-offertes) | ((s73 ^ action-w-nabellen-offertes) | (s88 ^ action-w-nabellen-offertes))) then (if (s44 ^ action-w-nabellen-offertes) then (Bernoulli(0.001427)) else (if (s73 ^ action-w-nabellen-offertes) then (true) else (if (s88 ^ action-w-nabellen-offertes) then Bernoulli(0.003012) else false))) else (if (s114 ^ action-w-nabellen-offertes) then (true) else (if (s119 ^ action-w-nabellen-offertes) then (Bernoulli(0.800000)) else (if (s120 ^ action-w-nabellen-offertes) then true else false))));

        s11' = if ((s9 ^ action-o-sent-back) | ((s10 ^ action-o-sent-back) | (s16 ^ action-o-sent-back))) then (if (s9 ^ action-o-sent-back) then (Bernoulli(0.991228)) else (if (s10 ^ action-o-sent-back) then (Bernoulli(0.997625)) else (if (s16 ^ action-o-sent-back) then true else false))) else (if ((s18 ^ action-o-sent-back) | (s24 ^ action-o-sent-back)) then (if (s18 ^ action-o-sent-back) then (Bernoulli(0.004630)) else (if (s24 ^ action-o-sent-back) then Bernoulli(0.002903) else false)) else (if (s44 ^ action-o-sent-back) then (Bernoulli(0.010169)) else (if (s72 ^ action-o-sent-back) then true else false)));

        s12' = if ((s10 ^ action-a-registered) | ((s13 ^ action-a-registered) | (s14 ^ action-a-registered))) then (if (s10 ^ action-a-registered) then (true) else (if (s13 ^ action-a-registered) then (true) else (if (s14 ^ action-a-registered) then true else false))) else (if ((s15 ^ action-a-registered) | (s16 ^ action-a-registered)) then (if (s15 ^ action-a-registered) then (true) else (if (s16 ^ action-a-registered) then true else false)) else (if (s44 ^ action-a-registered) then (Bernoulli(0.333333)) else (if (s72 ^ action-a-registered) then true else false)));

        s13' = if (((s10 ^ action-a-approved) | (s12 ^ action-a-approved)) | ((s14 ^ action-a-approved) | (s15 ^ action-a-approved))) then (if ((s10 ^ action-a-approved) | (s12 ^ action-a-approved)) then (if (s10 ^ action-a-approved) then (true) else (if (s12 ^ action-a-approved) then true else false)) else (if (s14 ^ action-a-approved) then (true) else (if (s15 ^ action-a-approved) then true else false))) else (if ((s16 ^ action-a-approved) | (s44 ^ action-a-approved)) then (if (s16 ^ action-a-approved) then (true) else (if (s44 ^ action-a-approved) then Bernoulli(0.090909) else false)) else (if (s68 ^ action-a-approved) then (Bernoulli(0.043478)) else (if (s72 ^ action-a-approved) then true else false)));

