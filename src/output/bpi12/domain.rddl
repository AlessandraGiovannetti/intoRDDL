    cpfs {

        // ---- transizioni: catena di Bernoulli condizionati (stick-breaking) ----
        // quando un (stato,azione) ha piu' esiti osservati, ciascuno tranne
        // l'ultimo pesca con probabilita' condizionata al non essersi gia' verificato
        // uno degli esiti precedenti dello stesso gruppo (riferimento a s{T}')
        // Transizione diretta a singolo tick: niente variabili di staging.
        s0' = false;

        s1' = if (s0 ^ action-a-submitted) then true else false;

        s2' = if (s1 ^ action-a-partlysubmitted) then true else false;

        s3' = if ((s2 ^ action-a-preaccepted) | (s20 ^ action-a-preaccepted)) then (if (s2 ^ action-a-preaccepted) then (Bernoulli(0.992147)) else (if (s20 ^ action-a-preaccepted) then Bernoulli(0.006246) else false)) else (if (s146 ^ action-a-preaccepted) then (Bernoulli(0.013889)) else (if (s171 ^ action-a-preaccepted) then true else false));

        s4' = if ((s3 ^ action-a-accepted) | ((s9 ^ action-a-accepted) | (s21 ^ action-a-accepted))) then (if (s3 ^ action-a-accepted) then (Bernoulli(0.983607)) else (if (s9 ^ action-a-accepted) then (true) else (if (s21 ^ action-a-accepted) then Bernoulli(0.028902) else false))) else (if ((s61 ^ action-a-accepted) | (s147 ^ action-a-accepted)) then (if (s61 ^ action-a-accepted) then (Bernoulli(0.011628)) else (if (s147 ^ action-a-accepted) then Bernoulli(0.016529) else false)) else (if (s154 ^ action-a-accepted) then (Bernoulli(0.009950)) else (if (s171 ^ action-a-accepted) then true else false)));

        s5' = if (((s4 ^ action-o-selected) | (s6 ^ action-o-selected)) | ((s9 ^ action-o-selected) | ((s10 ^ action-o-selected) | (s16 ^ action-o-selected)))) then (if ((s4 ^ action-o-selected) | (s6 ^ action-o-selected)) then (if (s4 ^ action-o-selected) then (true) else (if (s6 ^ action-o-selected) then true else false)) else (if (s9 ^ action-o-selected) then (true) else (if (s10 ^ action-o-selected) then (true) else (if (s16 ^ action-o-selected) then true else false)))) else (if ((s86 ^ action-o-selected) | (s154 ^ action-o-selected)) then (if (s86 ^ action-o-selected) then (Bernoulli(0.011111)) else (if (s154 ^ action-o-selected) then Bernoulli(0.021739) else false)) else (if (s155 ^ action-o-selected) then (Bernoulli(0.027027)) else (if (s159 ^ action-o-selected) then (true) else (if (s162 ^ action-o-selected) then true else false))));

        s6' = if (s4 ^ action-a-finalized) then (true) else (if (s5 ^ action-a-finalized) then (true) else (if (s9 ^ action-a-finalized) then true else false));

        s7' = if (s5 ^ action-o-created) then (true) else (if (s6 ^ action-o-created) then (true) else (if (s159 ^ action-o-created) then true else false));

        s8' = if (s7 ^ action-o-sent) then true else false;

        s9' = if (((s3 ^ action-w-completeren-aanvraag) | (s4 ^ action-w-completeren-aanvraag)) | ((s8 ^ action-w-completeren-aanvraag) | (s9 ^ action-w-completeren-aanvraag))) then (if ((s3 ^ action-w-completeren-aanvraag) | (s4 ^ action-w-completeren-aanvraag)) then (if (s3 ^ action-w-completeren-aanvraag) then (true) else (if (s4 ^ action-w-completeren-aanvraag) then true else false)) else (if (s8 ^ action-w-completeren-aanvraag) then (Bernoulli(0.997812)) else (if (s9 ^ action-w-completeren-aanvraag) then Bernoulli(0.994792) else false))) else (if ((s21 ^ action-w-completeren-aanvraag) | (s61 ^ action-w-completeren-aanvraag)) then (if (s21 ^ action-w-completeren-aanvraag) then (Bernoulli(0.024316)) else (if (s61 ^ action-w-completeren-aanvraag) then Bernoulli(0.009009) else false)) else (if (s147 ^ action-w-completeren-aanvraag) then (Bernoulli(0.014388)) else (if (s154 ^ action-w-completeren-aanvraag) then (Bernoulli(0.010811)) else (if (s171 ^ action-w-completeren-aanvraag) then true else false))));

        s10' = if (((s8 ^ action-w-nabellen-offertes) | ((s9 ^ action-w-nabellen-offertes) | (s10 ^ action-w-nabellen-offertes))) | (((s11 ^ action-w-nabellen-offertes) | (s61 ^ action-w-nabellen-offertes)) | ((s67 ^ action-w-nabellen-offertes) | (s73 ^ action-w-nabellen-offertes)))) then (if ((s8 ^ action-w-nabellen-offertes) | ((s9 ^ action-w-nabellen-offertes) | (s10 ^ action-w-nabellen-offertes))) then (if (s8 ^ action-w-nabellen-offertes) then (true) else (if (s9 ^ action-w-nabellen-offertes) then (true) else (if (s10 ^ action-w-nabellen-offertes) then Bernoulli(0.970068) else false))) else (if ((s11 ^ action-w-nabellen-offertes) | (s61 ^ action-w-nabellen-offertes)) then (if (s11 ^ action-w-nabellen-offertes) then (true) else (if (s61 ^ action-w-nabellen-offertes) then Bernoulli(0.023438) else false)) else (if (s67 ^ action-w-nabellen-offertes) then (Bernoulli(0.003992)) else (if (s73 ^ action-w-nabellen-offertes) then Bernoulli(0.011023) else false)))) else (if ((s86 ^ action-w-nabellen-offertes) | ((s154 ^ action-w-nabellen-offertes) | (s155 ^ action-w-nabellen-offertes))) then (if (s86 ^ action-w-nabellen-offertes) then (Bernoulli(0.021158)) else (if (s154 ^ action-w-nabellen-offertes) then (Bernoulli(0.118881)) else (if (s155 ^ action-w-nabellen-offertes) then Bernoulli(0.040448) else false))) else (if ((s159 ^ action-w-nabellen-offertes) | (s160 ^ action-w-nabellen-offertes)) then (if (s159 ^ action-w-nabellen-offertes) then (true) else (if (s160 ^ action-w-nabellen-offertes) then true else false)) else (if (s174 ^ action-w-nabellen-offertes) then (true) else (if (s175 ^ action-w-nabellen-offertes) then true else false))));

        s11' = if (((s9 ^ action-o-sent-back) | (s10 ^ action-o-sent-back)) | ((s67 ^ action-o-sent-back) | (s73 ^ action-o-sent-back))) then (if ((s9 ^ action-o-sent-back) | (s10 ^ action-o-sent-back)) then (if (s9 ^ action-o-sent-back) then (Bernoulli(0.976744)) else (if (s10 ^ action-o-sent-back) then Bernoulli(0.970060) else false)) else (if (s67 ^ action-o-sent-back) then (Bernoulli(0.012579)) else (if (s73 ^ action-o-sent-back) then Bernoulli(0.013441) else false))) else (if ((s86 ^ action-o-sent-back) | (s154 ^ action-o-sent-back)) then (if (s86 ^ action-o-sent-back) then (Bernoulli(0.014184)) else (if (s154 ^ action-o-sent-back) then Bernoulli(0.333333) else false)) else (if (s155 ^ action-o-sent-back) then (Bernoulli(0.137255)) else (if (s162 ^ action-o-sent-back) then true else false)));

        s12' = if ((s10 ^ action-a-registered) | ((s13 ^ action-a-registered) | (s14 ^ action-a-registered))) then (if (s10 ^ action-a-registered) then (Bernoulli(0.846154)) else (if (s13 ^ action-a-registered) then (true) else (if (s14 ^ action-a-registered) then true else false))) else (if (s15 ^ action-a-registered) then (true) else (if (s16 ^ action-a-registered) then (true) else (if (s162 ^ action-a-registered) then true else false)));

        s13' = if ((s10 ^ action-a-approved) | ((s12 ^ action-a-approved) | (s14 ^ action-a-approved))) then (if (s10 ^ action-a-approved) then (Bernoulli(0.913043)) else (if (s12 ^ action-a-approved) then (true) else (if (s14 ^ action-a-approved) then true else false))) else (if ((s15 ^ action-a-approved) | (s16 ^ action-a-approved)) then (if (s15 ^ action-a-approved) then (true) else (if (s16 ^ action-a-approved) then true else false)) else (if (s67 ^ action-a-approved) then (true) else (if (s162 ^ action-a-approved) then true else false)));

