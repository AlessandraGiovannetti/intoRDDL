non-fluents mdp_process_domain_nf {
    domain = mdp_process_domain;

    non-fluents {
        DUMMY = true;
    };
}

instance mdp_process_inst {
    domain = mdp_process_domain;
    non-fluents = mdp_process_domain_nf;

    init-state {
        s4 = true;

        amount-req-high = true;
        amount-req-low = false;
        amount-req-medium = false;
        remaining-time-minutes-high = true;
        remaining-time-minutes-low = false;
        remaining-time-minutes-medium = false;
    };

    max-nondef-actions = 1;
    horizon = 40;
    discount = 1.0;
}