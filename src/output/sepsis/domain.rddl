    cpfs {

        // ---- transizioni: catena di Bernoulli condizionati (stick-breaking) ----
        // quando un (stato,azione) ha piu' esiti osservati, ciascuno tranne
        // l'ultimo pesca con probabilita' condizionata al non essersi gia' verificato
        // uno degli esiti precedenti dello stesso gruppo (riferimento a s{T}')
        // Transizione diretta a singolo tick: niente variabili di staging.
        s0' = false;

        s1' = if ((s0 ^ action-er-registration) | ((s2 ^ action-er-registration) | (s3 ^ action-er-registration))) then (if (s0 ^ action-er-registration) then (true) else (if (s2 ^ action-er-registration) then (true) else (if (s3 ^ action-er-registration) then true else false))) else (if (s5 ^ action-er-registration) then (true) else (if (s6 ^ action-er-registration) then (true) else (if (s7 ^ action-er-registration) then true else false)));

        s2' = if (((s0 ^ action-leucocytes) | ((s1 ^ action-leucocytes) | (s2 ^ action-leucocytes))) | ((s3 ^ action-leucocytes) | ((s4 ^ action-leucocytes) | (s5 ^ action-leucocytes)))) then (if ((s0 ^ action-leucocytes) | ((s1 ^ action-leucocytes) | (s2 ^ action-leucocytes))) then (if (s0 ^ action-leucocytes) then (true) else (if (s1 ^ action-leucocytes) then (true) else (if (s2 ^ action-leucocytes) then true else false))) else (if (s3 ^ action-leucocytes) then (true) else (if (s4 ^ action-leucocytes) then (true) else (if (s5 ^ action-leucocytes) then true else false)))) else (if ((s6 ^ action-leucocytes) | ((s7 ^ action-leucocytes) | (s8 ^ action-leucocytes))) then (if (s6 ^ action-leucocytes) then (true) else (if (s7 ^ action-leucocytes) then (true) else (if (s8 ^ action-leucocytes) then true else false))) else (if (s9 ^ action-leucocytes) then (true) else (if (s10 ^ action-leucocytes) then (true) else (if (s25 ^ action-leucocytes) then true else false))));

        s3' = if (((s1 ^ action-crp) | (s2 ^ action-crp)) | ((s3 ^ action-crp) | ((s4 ^ action-crp) | (s5 ^ action-crp)))) then (if ((s1 ^ action-crp) | (s2 ^ action-crp)) then (if (s1 ^ action-crp) then (true) else (if (s2 ^ action-crp) then true else false)) else (if (s3 ^ action-crp) then (true) else (if (s4 ^ action-crp) then (true) else (if (s5 ^ action-crp) then true else false)))) else (if ((s6 ^ action-crp) | (s7 ^ action-crp)) then (if (s6 ^ action-crp) then (true) else (if (s7 ^ action-crp) then true else false)) else (if (s8 ^ action-crp) then (true) else (if (s9 ^ action-crp) then (true) else (if (s25 ^ action-crp) then true else false))));

        s4' = if (((s1 ^ action-lactic-acid) | (s2 ^ action-lactic-acid)) | ((s3 ^ action-lactic-acid) | ((s4 ^ action-lactic-acid) | (s5 ^ action-lactic-acid)))) then (if ((s1 ^ action-lactic-acid) | (s2 ^ action-lactic-acid)) then (if (s1 ^ action-lactic-acid) then (true) else (if (s2 ^ action-lactic-acid) then true else false)) else (if (s3 ^ action-lactic-acid) then (true) else (if (s4 ^ action-lactic-acid) then (true) else (if (s5 ^ action-lactic-acid) then true else false)))) else (if ((s6 ^ action-lactic-acid) | (s7 ^ action-lactic-acid)) then (if (s6 ^ action-lactic-acid) then (true) else (if (s7 ^ action-lactic-acid) then true else false)) else (if (s8 ^ action-lactic-acid) then (true) else (if (s9 ^ action-lactic-acid) then (true) else (if (s25 ^ action-lactic-acid) then true else false))));

        s5' = if (((s0 ^ action-er-triage) | (s1 ^ action-er-triage)) | ((s2 ^ action-er-triage) | (s3 ^ action-er-triage))) then (if ((s0 ^ action-er-triage) | (s1 ^ action-er-triage)) then (if (s0 ^ action-er-triage) then (true) else (if (s1 ^ action-er-triage) then true else false)) else (if (s2 ^ action-er-triage) then (true) else (if (s3 ^ action-er-triage) then true else false))) else (if ((s4 ^ action-er-triage) | (s6 ^ action-er-triage)) then (if (s4 ^ action-er-triage) then (true) else (if (s6 ^ action-er-triage) then true else false)) else (if (s7 ^ action-er-triage) then (true) else (if (s8 ^ action-er-triage) then true else false)));

        s6' = if (((s0 ^ action-er-sepsis-triage) | (s1 ^ action-er-sepsis-triage)) | ((s2 ^ action-er-sepsis-triage) | (s3 ^ action-er-sepsis-triage))) then (if ((s0 ^ action-er-sepsis-triage) | (s1 ^ action-er-sepsis-triage)) then (if (s0 ^ action-er-sepsis-triage) then (true) else (if (s1 ^ action-er-sepsis-triage) then true else false)) else (if (s2 ^ action-er-sepsis-triage) then (true) else (if (s3 ^ action-er-sepsis-triage) then true else false))) else (if ((s4 ^ action-er-sepsis-triage) | (s5 ^ action-er-sepsis-triage)) then (if (s4 ^ action-er-sepsis-triage) then (true) else (if (s5 ^ action-er-sepsis-triage) then true else false)) else (if (s7 ^ action-er-sepsis-triage) then (true) else (if (s9 ^ action-er-sepsis-triage) then true else false)));

        s7' = if (((s0 ^ action-iv-liquid) | (s1 ^ action-iv-liquid)) | ((s2 ^ action-iv-liquid) | (s3 ^ action-iv-liquid))) then (if ((s0 ^ action-iv-liquid) | (s1 ^ action-iv-liquid)) then (if (s0 ^ action-iv-liquid) then (true) else (if (s1 ^ action-iv-liquid) then true else false)) else (if (s2 ^ action-iv-liquid) then (true) else (if (s3 ^ action-iv-liquid) then true else false))) else (if ((s4 ^ action-iv-liquid) | (s5 ^ action-iv-liquid)) then (if (s4 ^ action-iv-liquid) then (true) else (if (s5 ^ action-iv-liquid) then true else false)) else (if (s6 ^ action-iv-liquid) then (true) else (if (s8 ^ action-iv-liquid) then (true) else (if (s9 ^ action-iv-liquid) then true else false))));

        s8' = if ((s2 ^ action-iv-antibiotics) | ((s3 ^ action-iv-antibiotics) | (s4 ^ action-iv-antibiotics))) then (if (s2 ^ action-iv-antibiotics) then (true) else (if (s3 ^ action-iv-antibiotics) then (true) else (if (s4 ^ action-iv-antibiotics) then true else false))) else (if ((s5 ^ action-iv-antibiotics) | (s6 ^ action-iv-antibiotics)) then (if (s5 ^ action-iv-antibiotics) then (true) else (if (s6 ^ action-iv-antibiotics) then true else false)) else (if (s7 ^ action-iv-antibiotics) then (true) else (if (s9 ^ action-iv-antibiotics) then true else false)));

        s9' = if (((s2 ^ action-admission-nc) | (s3 ^ action-admission-nc)) | ((s4 ^ action-admission-nc) | (s6 ^ action-admission-nc))) then (if ((s2 ^ action-admission-nc) | (s3 ^ action-admission-nc)) then (if (s2 ^ action-admission-nc) then (true) else (if (s3 ^ action-admission-nc) then true else false)) else (if (s4 ^ action-admission-nc) then (true) else (if (s6 ^ action-admission-nc) then true else false))) else (if ((s7 ^ action-admission-nc) | (s8 ^ action-admission-nc)) then (if (s7 ^ action-admission-nc) then (true) else (if (s8 ^ action-admission-nc) then true else false)) else (if (s9 ^ action-admission-nc) then (true) else (if (s25 ^ action-admission-nc) then true else false)));

        s10' = if ((s2 ^ action-release-a) | (s3 ^ action-release-a)) then (if (s2 ^ action-release-a) then (true) else (if (s3 ^ action-release-a) then true else false)) else (if (s4 ^ action-release-a) then (true) else (if (s9 ^ action-release-a) then true else false));

        s11' = if ((s10 ^ action-archive-application) | ((s24 ^ action-archive-application) | (s116 ^ action-archive-application))) then (if (s10 ^ action-archive-application) then (true) else (if (s24 ^ action-archive-application) then (true) else (if (s116 ^ action-archive-application) then true else false))) else (if (s136 ^ action-archive-application) then (true) else (if (s137 ^ action-archive-application) then (true) else (if (s151 ^ action-archive-application) then true else false)));

        s12' = false;

        s13' = if (s12 ^ action-er-registration) then (true) else (if (s18 ^ action-er-registration) then true else false);

        s14' = if ((s13 ^ action-er-triage) | (s15 ^ action-er-triage)) then (if (s13 ^ action-er-triage) then (true) else (if (s15 ^ action-er-triage) then true else false)) else (if (s16 ^ action-er-triage) then (true) else (if (s17 ^ action-er-triage) then true else false));

        s15' = if (s13 ^ action-er-sepsis-triage) then (true) else (if (s14 ^ action-er-sepsis-triage) then (true) else (if (s19 ^ action-er-sepsis-triage) then true else false));

