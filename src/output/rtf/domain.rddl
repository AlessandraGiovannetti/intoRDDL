        s14' = if ((s10 ^ action-archive-application) | (s13 ^ action-archive-application)) then (if (s10 ^ action-archive-application) then (true) else (if (s13 ^ action-archive-application) then true else false)) else (if (s15 ^ action-archive-application) then (true) else (if (s33 ^ action-archive-application) then true else false));

        s15' = if (((s9 ^ action-payment) | (s10 ^ action-payment)) | ((s11 ^ action-payment) | (s12 ^ action-payment))) then (if ((s9 ^ action-payment) | (s10 ^ action-payment)) then (if (s9 ^ action-payment) then (true) else (if (s10 ^ action-payment) then true else false)) else (if (s11 ^ action-payment) then (true) else (if (s12 ^ action-payment) then true else false))) else (if ((s15 ^ action-payment) | (s32 ^ action-payment)) then (if (s15 ^ action-payment) then (true) else (if (s32 ^ action-payment) then true else false)) else (if (s33 ^ action-payment) then (true) else (if (s34 ^ action-payment) then (true) else (if (s35 ^ action-payment) then true else false))));

        s16' = false;

