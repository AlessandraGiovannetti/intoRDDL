        s7' = if ((s1 ^ action-payment) | ((s2 ^ action-payment) | (s3 ^ action-payment))) then (if (s1 ^ action-payment) then (true) else (if (s2 ^ action-payment) then (true) else (if (s3 ^ action-payment) then true else false))) else (if ((s4 ^ action-payment) | (s7 ^ action-payment)) then (if (s4 ^ action-payment) then (true) else (if (s7 ^ action-payment) then true else false)) else (if (s30 ^ action-payment) then (true) else (if (s31 ^ action-payment) then true else false)));

        s8' = false;

