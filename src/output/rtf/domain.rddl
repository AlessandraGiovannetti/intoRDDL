    cpfs {

        // ---- transizioni: catena di Bernoulli condizionati (stick-breaking) ----
        // quando un (stato,azione) ha piu' esiti osservati, ciascuno tranne
        // l'ultimo pesca con probabilita' condizionata al non essersi gia' verificato
        // uno degli esiti precedenti dello stesso gruppo (riferimento a s{T}')
        // Transizione diretta a singolo tick: niente variabili di staging.
        s0' = false;

        s1' = if (s0 ^ action-create-fine) then true else false;

        s2' = if (s1 ^ action-send-fine) then (true) else (if (s7 ^ action-send-fine) then true else false);

        s3' = if (s2 ^ action-insert-fine-notification) then (true) else (if (s7 ^ action-insert-fine-notification) then (true) else (if (s36 ^ action-insert-fine-notification) then true else false));

        s4' = if ((s3 ^ action-add-penalty) | (s7 ^ action-add-penalty)) then (if (s3 ^ action-add-penalty) then (true) else (if (s7 ^ action-add-penalty) then true else false)) else (if (s36 ^ action-add-penalty) then (true) else (if (s37 ^ action-add-penalty) then true else false));

        s5' = if ((s4 ^ action-send-for-credit-collection) | (s7 ^ action-send-for-credit-collection)) then (if (s4 ^ action-send-for-credit-collection) then (true) else (if (s7 ^ action-send-for-credit-collection) then true else false)) else (if (s37 ^ action-send-for-credit-collection) then (true) else (if (s39 ^ action-send-for-credit-collection) then true else false));

        s6' = if ((s2 ^ action-archive-application) | (s5 ^ action-archive-application)) then (if (s2 ^ action-archive-application) then (true) else (if (s5 ^ action-archive-application) then true else false)) else (if (s7 ^ action-archive-application) then (true) else (if (s37 ^ action-archive-application) then true else false));

        s7' = if (((s1 ^ action-payment) | (s2 ^ action-payment)) | ((s3 ^ action-payment) | (s4 ^ action-payment))) then (if ((s1 ^ action-payment) | (s2 ^ action-payment)) then (if (s1 ^ action-payment) then (true) else (if (s2 ^ action-payment) then true else false)) else (if (s3 ^ action-payment) then (true) else (if (s4 ^ action-payment) then true else false))) else (if ((s7 ^ action-payment) | (s36 ^ action-payment)) then (if (s7 ^ action-payment) then (true) else (if (s36 ^ action-payment) then true else false)) else (if (s38 ^ action-payment) then (true) else (if (s39 ^ action-payment) then true else false)));

        s8' = false;

        s9' = if (s8 ^ action-create-fine) then true else false;

        s10' = if (s9 ^ action-send-fine) then (true) else (if (s15 ^ action-send-fine) then (true) else (if (s44 ^ action-send-fine) then true else false));

        s11' = if (s10 ^ action-insert-fine-notification) then (true) else (if (s15 ^ action-insert-fine-notification) then (true) else (if (s44 ^ action-insert-fine-notification) then true else false));

        s12' = if ((s11 ^ action-add-penalty) | ((s15 ^ action-add-penalty) | (s44 ^ action-add-penalty))) then (if (s11 ^ action-add-penalty) then (Bernoulli(0.999401)) else (if (s15 ^ action-add-penalty) then (true) else (if (s44 ^ action-add-penalty) then true else false))) else (if (s45 ^ action-add-penalty) then (true) else (if (s46 ^ action-add-penalty) then (true) else (if (s47 ^ action-add-penalty) then true else false)));

        s13' = if (s12 ^ action-send-for-credit-collection) then (true) else (if (s15 ^ action-send-for-credit-collection) then (true) else (if (s47 ^ action-send-for-credit-collection) then true else false));

        s14' = if ((s10 ^ action-archive-application) | (s13 ^ action-archive-application)) then (if (s10 ^ action-archive-application) then (true) else (if (s13 ^ action-archive-application) then true else false)) else (if (s15 ^ action-archive-application) then (true) else (if (s45 ^ action-archive-application) then true else false));

        s15' = if (((s9 ^ action-payment) | (s10 ^ action-payment)) | ((s11 ^ action-payment) | (s12 ^ action-payment))) then (if ((s9 ^ action-payment) | (s10 ^ action-payment)) then (if (s9 ^ action-payment) then (true) else (if (s10 ^ action-payment) then true else false)) else (if (s11 ^ action-payment) then (true) else (if (s12 ^ action-payment) then true else false))) else (if ((s15 ^ action-payment) | (s45 ^ action-payment)) then (if (s15 ^ action-payment) then (true) else (if (s45 ^ action-payment) then true else false)) else (if (s46 ^ action-payment) then (true) else (if (s47 ^ action-payment) then true else false)));

        s16' = false;

        s17' = if (s16 ^ action-create-fine) then true else false;

        s18' = if (s17 ^ action-send-fine) then (true) else (if (s23 ^ action-send-fine) then true else false);

        s19' = if (s18 ^ action-insert-fine-notification) then (true) else (if (s23 ^ action-insert-fine-notification) then (true) else (if (s40 ^ action-insert-fine-notification) then true else false));

        s20' = if ((s19 ^ action-add-penalty) | (s23 ^ action-add-penalty)) then (if (s19 ^ action-add-penalty) then (true) else (if (s23 ^ action-add-penalty) then true else false)) else (if (s40 ^ action-add-penalty) then (true) else (if (s41 ^ action-add-penalty) then (true) else (if (s42 ^ action-add-penalty) then true else false)));

        s21' = if (s20 ^ action-send-for-credit-collection) then (true) else (if (s23 ^ action-send-for-credit-collection) then (true) else (if (s43 ^ action-send-for-credit-collection) then true else false));

        s22' = if ((s18 ^ action-archive-application) | (s21 ^ action-archive-application)) then (if (s18 ^ action-archive-application) then (true) else (if (s21 ^ action-archive-application) then true else false)) else (if (s23 ^ action-archive-application) then (true) else (if (s41 ^ action-archive-application) then true else false));

        s23' = if (((s17 ^ action-payment) | (s18 ^ action-payment)) | ((s19 ^ action-payment) | (s20 ^ action-payment))) then (if ((s17 ^ action-payment) | (s18 ^ action-payment)) then (if (s17 ^ action-payment) then (true) else (if (s18 ^ action-payment) then true else false)) else (if (s19 ^ action-payment) then (true) else (if (s20 ^ action-payment) then true else false))) else (if ((s23 ^ action-payment) | (s40 ^ action-payment)) then (if (s23 ^ action-payment) then (true) else (if (s40 ^ action-payment) then true else false)) else (if (s41 ^ action-payment) then (true) else (if (s42 ^ action-payment) then (true) else (if (s43 ^ action-payment) then true else false))));

        s24' = false;

        s25' = if (s24 ^ action-create-fine) then true else false;

        s26' = if (s25 ^ action-send-fine) then (true) else (if (s31 ^ action-send-fine) then true else false);

        s27' = if (s26 ^ action-insert-fine-notification) then (true) else (if (s31 ^ action-insert-fine-notification) then (true) else (if (s32 ^ action-insert-fine-notification) then true else false));

        s28' = if ((s27 ^ action-add-penalty) | ((s31 ^ action-add-penalty) | (s32 ^ action-add-penalty))) then (if (s27 ^ action-add-penalty) then (true) else (if (s31 ^ action-add-penalty) then (true) else (if (s32 ^ action-add-penalty) then true else false))) else (if (s33 ^ action-add-penalty) then (true) else (if (s34 ^ action-add-penalty) then (true) else (if (s35 ^ action-add-penalty) then true else false)));

        s29' = if ((s28 ^ action-send-for-credit-collection) | (s31 ^ action-send-for-credit-collection)) then (if (s28 ^ action-send-for-credit-collection) then (true) else (if (s31 ^ action-send-for-credit-collection) then true else false)) else (if (s34 ^ action-send-for-credit-collection) then (true) else (if (s35 ^ action-send-for-credit-collection) then true else false));

        s30' = if ((s26 ^ action-archive-application) | (s29 ^ action-archive-application)) then (if (s26 ^ action-archive-application) then (true) else (if (s29 ^ action-archive-application) then true else false)) else (if (s31 ^ action-archive-application) then (true) else (if (s33 ^ action-archive-application) then true else false));

        s31' = if (((s25 ^ action-payment) | (s26 ^ action-payment)) | ((s27 ^ action-payment) | (s28 ^ action-payment))) then (if ((s25 ^ action-payment) | (s26 ^ action-payment)) then (if (s25 ^ action-payment) then (true) else (if (s26 ^ action-payment) then true else false)) else (if (s27 ^ action-payment) then (true) else (if (s28 ^ action-payment) then true else false))) else (if ((s31 ^ action-payment) | (s32 ^ action-payment)) then (if (s31 ^ action-payment) then (true) else (if (s32 ^ action-payment) then true else false)) else (if (s34 ^ action-payment) then (true) else (if (s35 ^ action-payment) then true else false)));

        s32' = if (s26 ^ action-insert-date-appeal-to-prefecture) then (true) else (if (s27 ^ action-insert-date-appeal-to-prefecture) then (true) else (if (s28 ^ action-insert-date-appeal-to-prefecture) then true else false));

        s33' = if ((s27 ^ action-send-appeal-to-prefecture) | (s28 ^ action-send-appeal-to-prefecture)) then (if (s27 ^ action-send-appeal-to-prefecture) then (true) else (if (s28 ^ action-send-appeal-to-prefecture) then true else false)) else (if (s29 ^ action-send-appeal-to-prefecture) then (true) else (if (s31 ^ action-send-appeal-to-prefecture) then (true) else (if (s32 ^ action-send-appeal-to-prefecture) then true else false)));

        s34' = if ((s28 ^ action-receive-result-appeal-from-prefecture) | (s31 ^ action-receive-result-appeal-from-prefecture)) then (if (s28 ^ action-receive-result-appeal-from-prefecture) then (true) else (if (s31 ^ action-receive-result-appeal-from-prefecture) then true else false)) else (if (s32 ^ action-receive-result-appeal-from-prefecture) then (true) else (if (s33 ^ action-receive-result-appeal-from-prefecture) then (true) else (if (s35 ^ action-receive-result-appeal-from-prefecture) then true else false)));

        s35' = if (s28 ^ action-notify-result-appeal-to-offender) then (true) else (if (s31 ^ action-notify-result-appeal-to-offender) then (true) else (if (s34 ^ action-notify-result-appeal-to-offender) then true else false));

        s36' = if (s2 ^ action-insert-date-appeal-to-prefecture) then (true) else (if (s3 ^ action-insert-date-appeal-to-prefecture) then (true) else (if (s4 ^ action-insert-date-appeal-to-prefecture) then true else false));

        s37' = if (s4 ^ action-send-appeal-to-prefecture) then (true) else (if (s36 ^ action-send-appeal-to-prefecture) then (true) else (if (s39 ^ action-send-appeal-to-prefecture) then true else false));

        s38' = if (s4 ^ action-receive-result-appeal-from-prefecture) then (true) else (if (s36 ^ action-receive-result-appeal-from-prefecture) then (true) else (if (s37 ^ action-receive-result-appeal-from-prefecture) then true else false));

        s39' = if (s38 ^ action-notify-result-appeal-to-offender) then true else false;

        s40' = if (s18 ^ action-insert-date-appeal-to-prefecture) then (true) else (if (s19 ^ action-insert-date-appeal-to-prefecture) then (true) else (if (s20 ^ action-insert-date-appeal-to-prefecture) then true else false));

        s41' = if ((s19 ^ action-send-appeal-to-prefecture) | ((s20 ^ action-send-appeal-to-prefecture) | (s21 ^ action-send-appeal-to-prefecture))) then (if (s19 ^ action-send-appeal-to-prefecture) then (true) else (if (s20 ^ action-send-appeal-to-prefecture) then (true) else (if (s21 ^ action-send-appeal-to-prefecture) then true else false))) else (if (s23 ^ action-send-appeal-to-prefecture) then (true) else (if (s40 ^ action-send-appeal-to-prefecture) then (true) else (if (s42 ^ action-send-appeal-to-prefecture) then true else false)));

        s42' = if (s20 ^ action-receive-result-appeal-from-prefecture) then (true) else (if (s40 ^ action-receive-result-appeal-from-prefecture) then (true) else (if (s41 ^ action-receive-result-appeal-from-prefecture) then true else false));

        s43' = if (s20 ^ action-notify-result-appeal-to-offender) then (true) else (if (s41 ^ action-notify-result-appeal-to-offender) then (true) else (if (s42 ^ action-notify-result-appeal-to-offender) then true else false));

        s44' = if ((s9 ^ action-insert-date-appeal-to-prefecture) | (s10 ^ action-insert-date-appeal-to-prefecture)) then (if (s9 ^ action-insert-date-appeal-to-prefecture) then (true) else (if (s10 ^ action-insert-date-appeal-to-prefecture) then true else false)) else (if (s11 ^ action-insert-date-appeal-to-prefecture) then (true) else (if (s12 ^ action-insert-date-appeal-to-prefecture) then true else false));

        s45' = if ((s11 ^ action-send-appeal-to-prefecture) | (s12 ^ action-send-appeal-to-prefecture)) then (if (s11 ^ action-send-appeal-to-prefecture) then (true) else (if (s12 ^ action-send-appeal-to-prefecture) then true else false)) else (if (s13 ^ action-send-appeal-to-prefecture) then (true) else (if (s44 ^ action-send-appeal-to-prefecture) then (true) else (if (s46 ^ action-send-appeal-to-prefecture) then true else false)));

