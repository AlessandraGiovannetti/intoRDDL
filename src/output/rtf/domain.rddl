        s33' = if ((s11 ^ action-send-appeal-to-prefecture) | ((s12 ^ action-send-appeal-to-prefecture) | (s13 ^ action-send-appeal-to-prefecture))) then (if (s11 ^ action-send-appeal-to-prefecture) then (true) else (if (s12 ^ action-send-appeal-to-prefecture) then (true) else (if (s13 ^ action-send-appeal-to-prefecture) then true else false))) else (if (s15 ^ action-send-appeal-to-prefecture) then (true) else (if (s32 ^ action-send-appeal-to-prefecture) then (true) else (if (s34 ^ action-send-appeal-to-prefecture) then true else false)));

        s34' = if ((s11 ^ action-receive-result-appeal-from-prefecture) | (s12 ^ action-receive-result-appeal-from-prefecture)) then (if (s11 ^ action-receive-result-appeal-from-prefecture) then (true) else (if (s12 ^ action-receive-result-appeal-from-prefecture) then true else false)) else (if (s32 ^ action-receive-result-appeal-from-prefecture) then (true) else (if (s33 ^ action-receive-result-appeal-from-prefecture) then true else false));

