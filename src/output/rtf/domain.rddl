        s36' = if (((((s3 ^ action-appeal-to-judge) | (s4 ^ action-appeal-to-judge)) | ((s11 ^ action-appeal-to-judge) | (s12 ^ action-appeal-to-judge))) | (((s19 ^ action-appeal-to-judge) | (s20 ^ action-appeal-to-judge)) | ((s27 ^ action-appeal-to-judge) | (s30 ^ action-appeal-to-judge)))) | ((((s31 ^ action-appeal-to-judge) | (s34 ^ action-appeal-to-judge)) | ((s35 ^ action-appeal-to-judge) | (s37 ^ action-appeal-to-judge))) | (((s38 ^ action-appeal-to-judge) | (s50 ^ action-appeal-to-judge)) | ((s51 ^ action-appeal-to-judge) | ((s58 ^ action-appeal-to-judge) | (s62 ^ action-appeal-to-judge)))))) then (if ((((s3 ^ action-appeal-to-judge) | (s4 ^ action-appeal-to-judge)) | ((s11 ^ action-appeal-to-judge) | (s12 ^ action-appeal-to-judge))) | (((s19 ^ action-appeal-to-judge) | (s20 ^ action-appeal-to-judge)) | ((s27 ^ action-appeal-to-judge) | (s30 ^ action-appeal-to-judge)))) then (if (((s3 ^ action-appeal-to-judge) | (s4 ^ action-appeal-to-judge)) | ((s11 ^ action-appeal-to-judge) | (s12 ^ action-appeal-to-judge))) then (if ((s3 ^ action-appeal-to-judge) | (s4 ^ action-appeal-to-judge)) then (if (s3 ^ action-appeal-to-judge) then (true) else (if (s4 ^ action-appeal-to-judge) then true else false)) else (if (s11 ^ action-appeal-to-judge) then (true) else (if (s12 ^ action-appeal-to-judge) then true else false))) else (if ((s19 ^ action-appeal-to-judge) | (s20 ^ action-appeal-to-judge)) then (if (s19 ^ action-appeal-to-judge) then (true) else (if (s20 ^ action-appeal-to-judge) then true else false)) else (if (s27 ^ action-appeal-to-judge) then (true) else (if (s30 ^ action-appeal-to-judge) then true else false)))) else (if (((s31 ^ action-appeal-to-judge) | (s34 ^ action-appeal-to-judge)) | ((s35 ^ action-appeal-to-judge) | (s37 ^ action-appeal-to-judge))) then (if ((s31 ^ action-appeal-to-judge) | (s34 ^ action-appeal-to-judge)) then (if (s31 ^ action-appeal-to-judge) then (true) else (if (s34 ^ action-appeal-to-judge) then true else false)) else (if (s35 ^ action-