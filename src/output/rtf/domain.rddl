        s12' = if ((s11 ^ action-add-penalty) | ((s15 ^ action-add-penalty) | (s32 ^ action-add-penalty))) then (if (s11 ^ action-add-penalty) then (Bernoulli(0.999710)) else (if (s15 ^ action-add-penalty) then (true) else (if (s32 ^ action-add-penalty) then true else false))) else (if (s33 ^ action-add-penalty) then (true) else (if (s34 ^ action-add-penalty) then (true) else (if (s35 ^ action-add-penalty) then true else false)));

