        s30' = if (s4 ^ action-receive-result-appeal-from-prefecture) then (true) else (if (s28 ^ action-receive-result-appeal-from-prefecture) then (true) else (if (s29 ^ action-receive-result-appeal-from-prefecture) then true else false));

