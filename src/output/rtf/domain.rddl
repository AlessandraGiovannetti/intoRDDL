        remaining-time-minutes-high : { state-fluent, bool, default=false };
        remaining-time-minutes-low : { state-fluent, bool, default=false };
        remaining-time-minutes-medium : { state-fluent, bool, default=false };

        // -----------------------
        // azioni: una booleana scalare per ciascuna attivita' osservata nel log
        // -----------------------
        action-add-penalty : { action-fluent, bool, default=false };
        action-appeal-to-judge : { action-fluent, bool, default=false };
        action-create-fine : { action-fluent, bool, default=false };
        action-insert-date-appeal-to-prefecture : { action-fluent, bool, default=false };
        action-insert-fine-notification : { action-fluent, bool, default=false };
        action-notify-result-appeal-to-offender : { action-fluent, bool, default=false };
        action-payment : { action-fluent, bool, default=false };
        action-receive-result-appeal-from-prefecture : { action-fluent, bool, default=false };
        action-send-appeal-to-prefecture : { action-fluent, bool, default=false };
        action-send-fine : { action-fluent, bool, default=false };
        action-send-for-credit-collection : { action-fluent, bool, default=false };
        action-archive-application : { action-fluent, bool, default=false };
